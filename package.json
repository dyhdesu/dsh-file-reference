{
  "name": "dsh-file-reference",
  "displayName": "DSH 文件树右键引用",
  "description": "右键一键引用：侧栏「工作区文件」树里的文件/文件夹，或消息里已交付的文件卡片，一键把 @引用 chip 插入当前会话输入框（走宿主拖拽入文件的同一通道），另可复制引用文本。Right-click a file-tree row or a delivered-file card to insert a native @ reference chip into the composer.",
  "version": "0.3.0",
  "type": "module",
  "author": "dyhdesu",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dyhdesu/dsh-file-reference.git"
  },
  "homepage": "https://github.com/dyhdesu/dsh-file-reference#readme",
  "bugs": {
    "url": "https://github.com/dyhdesu/dsh-file-reference/issues"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "file-reference",
    "file-tree",
    "context-menu",
    "sidebar",
    "mention"
  ],
  "main": "src/index.js",
  "icon": "./icon.png",
  "exports": {
    ".": "./src/index.js",
    "./client": "./src/client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "src",
    "test",
    "cordis.patch.yml",
    "README.md",
    "LICENSE",
    "icon.png"
  ],
  "scripts": {
    "test": "node --test \"test/*.test.mjs\"",
    "prepublishOnly": "npm test"
  },
  "engines": {
    "node": ">=20"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web"
    }
  }
}
